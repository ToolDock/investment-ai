{
  "meta": {
    "purpose": "リターン・ドローダウン・直近の傾きから局面ラベルを決める。実験の台本（月次）と本番（日次）で同じ分類器を使い、しきい値だけを単位ごとに変える。",
    "phases": ["暴落", "急回復", "安定下落", "暴騰", "停滞", "安定上昇"],
    "note": "上から順に判定し、最初に当てはまったものを採る。trend は直近の累積リターン（月次は3か月、日次は20営業日）。month のしきい値は scenario_scripted.json の手書きラベル60件に対して60分の55が一致する値。day はそれを日次のばらつきに合わせて縮めたもの。",
    "residual": "月次で食い違う5件はいずれも境界例（高値圏での+3〜4%を『急回復』『暴騰』のどちらと読むか）。台本側は物語の都合で付けたラベルなので、分類器を無理に合わせない。"
  },
  "month": {
    "trend_window": 3,
    "rules": [
      {"phase": "暴落",     "ret_max": -0.06},
      {"phase": "急回復",   "ret_min": 0.028, "dd_max": -0.02},
      {"phase": "暴騰",     "ret_min": 0.04},
      {"phase": "安定下落", "ret_max": -0.009},
      {"phase": "停滞",     "ret_min": -0.009, "ret_max": 0.010, "trend_abs_max": 0.06},
      {"phase": "安定上昇"}
    ]
  },
  "day": {
    "trend_window": 20,
    "rules": [
      {"phase": "暴落",     "ret_max": -0.025},
      {"phase": "急回復",   "ret_min": 0.012, "dd_max": -0.02},
      {"phase": "暴騰",     "ret_min": 0.018},
      {"phase": "安定下落", "ret_max": -0.003},
      {"phase": "停滞",     "ret_min": -0.003, "ret_max": 0.004, "trend_abs_max": 0.03},
      {"phase": "安定上昇"}
    ]
  }
}
